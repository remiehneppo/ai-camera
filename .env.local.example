# Local-only camera lab input. Copy to .env.local and insert your credential-bearing URI.
# Never commit .env.local, paste this value into logs, or print it in diagnostics.
CAMERA_RTSP_URL=rtsp://<username>:<url-encoded-password>@<camera-host>:554/h264/ch1/main/av_stream
# go2rtc control API Basic authentication (required by compose.yaml and edge media engine)
GO2RTC_API_USER=<go2rtc-api-username>
GO2RTC_API_PASSWORD=<go2rtc-api-password>
